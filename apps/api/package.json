{
  "name": "@task-list/api",
  "version": "0.1.0",
  "private": true,
  "description": "task_list 后端 API（Express 5 + TypeScript）",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
